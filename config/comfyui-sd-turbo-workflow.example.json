{
  "name": "SD-Turbo FP16 (512px, one step)",
  "bindings": {
    "prompt": {"node": "6", "input": "text"},
    "seed": {"node": "3", "input": "noise_seed"},
    "width": {"node": "5", "input": "width"},
    "height": {"node": "5", "input": "height"}
  },
  "workflow": {
    "4": {"class_type": "DiffusersLoader", "inputs": {"model_path": "sd-turbo-fp16"}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
    "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
    "5": {"class_type": "EmptyLatentImage", "inputs": {"width": 512, "height": 512, "batch_size": 1}},
    "10": {"class_type": "SDTurboScheduler", "inputs": {"model": ["4", 0], "steps": 1, "denoise": 1.0}},
    "11": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
    "3": {"class_type": "SamplerCustom", "inputs": {"model": ["4", 0], "add_noise": true, "noise_seed": 0, "cfg": 1.0, "positive": ["6", 0], "negative": ["7", 0], "sampler": ["11", 0], "sigmas": ["10", 0], "latent_image": ["5", 0]}},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
    "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "PixelStation"}}
  }
}
