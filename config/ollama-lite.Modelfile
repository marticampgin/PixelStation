# Optional local alias using the installed Hugging Face weight blob.
# Requires Ollama with the native lfm2-thinking renderer/parser (verified 0.32.14).
# Prefer the official LiquidAI/lfm2.5-2.6b registry model for fresh installs.
# Recreate an older alias with:
# ollama create pixel-station-lfm2.5:2.6b -f config/ollama-lite.Modelfile
FROM hf.co/LiquidAI/LFM2.5-2.6B-GGUF:Q4_K_M
RENDERER lfm2-thinking
PARSER lfm2-thinking
TEMPLATE "{{ .Prompt }}"
PARAMETER temperature 0.1
PARAMETER top_k 50
PARAMETER repeat_penalty 1.1
